# Vulcan interactive shell configuration

# Always start in the sandbox workspace.
cd /workspace

# Report cwd to the frontend via an OSC sequence.
PROMPT_COMMAND='printf "\033]51;CWD;%s\007" "$(pwd)"'

# Build the Vulcan prompt: user → cwd (branch) $
vulcan_prompt() {
    local BLUE='\[\033[38;2;15;98;254m\]'        # IBM blue #0f62fe
    local LIGHT_BLUE='\[\033[38;2;120;180;255m\]' # light blue
    local RED='\[\033[38;5;196m\]'              # red
    local RESET='\[\033[0m\]'                     # reset
    local dir=$(pwd)
    local branch=""
    if branch=$(git symbolic-ref --short HEAD 2>/dev/null) || branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null); then
        printf "%s%s%s → %s%s%s (%s%s%s) $ " \
            "$BLUE" "$USER" "$RESET" \
            "$LIGHT_BLUE" "$dir" "$RESET" \
            "$RED" "$branch" "$RESET"
    else
        printf "%s%s%s → %s%s%s $ " \
            "$BLUE" "$USER" "$RESET" \
            "$LIGHT_BLUE" "$dir" "$RESET"
    fi
}

PS1='$(vulcan_prompt)'

# Basic readline / history defaults for the sandbox.
HISTSIZE=1000
HISTFILE="$HOME/.bash_history"
set -o history

# Colorize ls output by file type (directories, executables, symlinks, etc.).
alias ls='ls --color=auto'
